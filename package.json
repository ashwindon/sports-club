{
  "name": "sports-club",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser cricket batting game where your phone is the bat.",
  "scripts": {
    "dev": "concurrently --kill-others --names peer,vite --prefix-colors blue,green \"npm:dev:peer\" \"npm:dev:vite\"",
    "dev:http": "concurrently --kill-others --names peer,vite --prefix-colors blue,green \"npm:dev:peer\" \"vite --mode http\"",
    "dev:vite": "vite",
    "dev:peer": "node scripts/peer-server.mjs",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@webrtc-remote-control/core": "^0.6.0",
    "ahrs": "^1.3.3",
    "peerjs": "^1.5.5",
    "qrcode": "^1.5.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "concurrently": "^10.0.6",
    "peer": "^1.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
